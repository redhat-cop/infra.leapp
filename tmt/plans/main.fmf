summary: Base plan for infra.leapp tests

environment:
  SR_ANSIBLE_VER: ""
  SR_REPO_NAME: ""
  SR_PYTHON_VERSION: 3.12
  SR_ONLY_TESTS: ""
  SR_TEST_LOCAL_CHANGES: true
  SR_PR_NUM: ""
  SR_LSR_USER: ""
  SR_LSR_DOMAIN: ""
  SR_LSR_SSH_KEY: ""
  SR_ARTIFACTS_DIR: ""
  SR_ARTIFACTS_URL: ""
  SR_TFT_DEBUG: false
  TMT_CONTEXT_INITIATOR: $@{initiator}
  TMT_CONTEXT_INFRA: $@{infra}

discover:
  - name: Prepare managed node
    how: fmf
    where: managed_node
    filter: tag:prep_managed_node
  - name: Prepare control node
    how: fmf
    where: control_node
    filter: tag:prep_control_node

adjust:
  # File that provides URLs for images and repositories
  - when: initiator is not defined
    environment-file+:
      - https://<GitLab CEE RedHat instance>/oamg/tests-ansible-collection-leapp/-/raw/main/leapp_coll_env_file.yml

  # Per-version mappings for managed node.
  # In CI, SR_ANSIBLE_VER is also passed by the workflow from test-matrix.json.
  - when: managed_node == rhel7
    environment+:
      SR_ANSIBLE_VER: "2.14"
      TF_MANAGED_NODE_COMPOSE: "RHEL-7-LatestUpdated"
      MINUTETIP_MANAGED_NODE_IMAGE: RHEL-7.9
      LOCALVM_MANAGED_NODE_IMAGE: ${RHEL_7_9_image}
  - when: managed_node == rhel8
    environment+:
      SR_ANSIBLE_VER: "2.16"
      TF_MANAGED_NODE_COMPOSE: "RHEL-8.10.0-Nightly"
      MINUTETIP_MANAGED_NODE_IMAGE: RHEL-8.10.0
      LOCALVM_MANAGED_NODE_IMAGE: ${RHEL_8_10_image}
  - when: managed_node == rhel9
    environment+:
      SR_ANSIBLE_VER: "2.17"
      TF_MANAGED_NODE_COMPOSE: "RHEL-9.9.0-Nightly"
      MINUTETIP_MANAGED_NODE_IMAGE: RHEL-9.9.0
      LOCALVM_MANAGED_NODE_IMAGE: ${RHEL_9_9_image}

  # Per-version mappings for control node.
  - when: control_node == rhel9
    environment+:
      TF_CONTROL_NODE_COMPOSE: "RHEL-9-Nightly"
      MINUTETIP_CONTROL_NODE_IMAGE: $@{control_node}
      LOCALVM_CONTROL_NODE_IMAGE: ${RHEL_9_latest_image}
  - when: control_node == rhel10
    environment+:
      TF_CONTROL_NODE_COMPOSE: "RHEL-10-Nightly"
      MINUTETIP_CONTROL_NODE_IMAGE: $@{control_node}
      LOCALVM_CONTROL_NODE_IMAGE: ${RHEL_10_latest_image}

  # ---- Testing Farm (CI) ----
  - when: initiator == github-ci and infra == testing-farm or initiator == rhel-ci
    provision+:
      - name: control-node01
        role: control_node
        how: artemis
        image: ${TF_CONTROL_NODE_COMPOSE}
        arch: x86_64
      - name: managed-node01
        role: managed_node
        how: artemis
        image: ${TF_MANAGED_NODE_COMPOSE}
        arch: x86_64

  # ---- 1minutetip VMs ----
  # Example: tmt -c infra=minutetip -c managed_node=rhel8 -c control_node=rhel9 try -p /plans/integration
  - when: infra == minutetip
    provision+:
      - name: control-node01
        role: control_node
        how: minute
        image: ${MINUTETIP_CONTROL_NODE_IMAGE}
      - name: managed-node01
        role: managed_node
        how: minute
        image: ${MINUTETIP_MANAGED_NODE_IMAGE}

  # ---- Local VMs (virtual) ----
  # Example: tmt -c managed_node=rhel8 -c control_node=rhel9 try -p /plans/integration
  - when: infra is not defined
    provision+:
      - name: control-node01
        role: control_node
        how: virtual
        connection: system
        image: ${LOCALVM_CONTROL_NODE_IMAGE}
      - name: managed-node01
        role: managed_node
        how: virtual
        connection: system
        image: ${LOCALVM_MANAGED_NODE_IMAGE}

prepare:
  - name: Replaces repositories with custom repos
    order: 10
    script: $TMT_TREE/tmt/scripts/replace_repos_with_custom_repos.sh

execute:
  how: tmt

report:
  # ---- Local reporting ----
  - when: initiator is not defined
  - how: display
  - how: html
    open: false
